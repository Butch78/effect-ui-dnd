{
  "name": "effect-ui-dnd",
  "version": "0.1.0",
  "description": "Pointer and keyboard drag and drop for Effect UI: drop zones and sortable lists",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "effect-tsgo tsc --noEmit -p tsconfig.json",
    "check": "effect-tsgo tsc --noEmit -p tsconfig.json && vitest run",
    "example": "vp dev example",
    "example:build": "vp build example --outDir ../dist/example --emptyOutDir"
  },
  "peerDependencies": {
    "@effect/ui": "*",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704b",
    "@effect/vitest": "4.1.5",
    "effect": "4.1.5",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "1.8.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.23.0"
}
